{
  "name": "topiccut",
  "productName": "TopicCut",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "author": "TopicCut contributors",
  "type": "module",
  "description": "Subtitle-driven video clip discovery tool, with local Whisper captioning for videos without subtitles",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "demo": "npm run build && cross-env TOPICCUT_DEMO=1 electron .",
    "check": "node --experimental-strip-types scripts/check-logic.ts",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:subtitles": "node scripts/verify-subtitles.mjs",
    "verify:flow": "npm run build && node scripts/verify-flow.mjs",
    "verify:ai": "npm run build && node scripts/verify-ai.mjs",
    "verify:real-asr": "npm run build && node scripts/verify-real-asr.mjs",
    "find:ffmpeg": "node scripts/find-ffmpeg.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.2"
  }
}
